# Copy this file to .env and fill in real values for local development.
# .env is gitignored; this file is the template that is committed.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Where the OCR service (ocr/, see ADR 9) is reachable. The published port
# when running it via `docker compose up ocr` from the repo root.
OCR_SERVICE_URL=http://localhost:8001
